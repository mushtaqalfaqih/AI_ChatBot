# AI ChatBot environment configuration
# Change PROVIDER to openai, gemini, ollama, or claude.
# If OPENAI_API_KEY is empty and PROVIDER=openai, the app falls back to gemini.

PROVIDER=openai
MODEL=gpt-3.5-turbo
TEMPERATURE=0.7
MAX_TOKENS=1000

OPENAI_API_KEY=
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434

APP_NAME=AI ChatBot
APP_VERSION=1.0.0
LOG_LEVEL=INFO
